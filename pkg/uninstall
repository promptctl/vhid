#!/bin/bash
# Removes what the vhid pkg installed: stops the daemon's job and the menu bar item, deletes
# the files the pkg put down (this script among them), and forgets the pkg's receipt. The
# pqrs driver the pkg also installed is left in place: Karabiner-Elements may be using it.
#
#   sudo /usr/local/libexec/vhid-uninstall
#   sudo /usr/local/libexec/vhid-uninstall --driver    # and the pqrs driver after vhid's jobs stop
#   /usr/local/libexec/vhid-uninstall --paths    # what it removes, one per line, and nothing else
#
# Running it again finds nothing and says so. It touches the one service it was packed for
# and no other, so the .dev job a working tree registers is never stopped by it.
#
# scripts/stage-uninstall writes in, from scripts/make-pkg, the service - the answer the
# packed vhid gives, which pkg/scripts/service carries for preinstall and postinstall -
# the pkg's receipt identifier, and pkg/scripts/stop-job, so the job stopped here is the
# job the install started, stopped the way preinstall stops it. [LAW:one-source-of-truth]
#
# VHID_UNINSTALL_ROOT prefixes every path it removes, for scripts/uninstall-test, which runs as
# nobody's root; as root it is refused, since launchctl and pkgutil would still act on
# this Mac while the files removed were somewhere else.
#
# Held to bash 3.2, like every script here.
set -euo pipefail

service=@SERVICE@
receipt=@RECEIPT@
root=${VHID_UNINSTALL_ROOT:-}

# Every path the pkg's payload holds that is not a directory; scripts/check-pkg holds this
# list to the pkg's own bill of materials, so the two cannot drift.
paths() {
  cat <<PATHS
/usr/local/bin/vhid
/usr/local/bin/eyes
/usr/local/libexec/vhidd
/usr/local/libexec/vhid-menubar
/usr/local/libexec/vhid-record.app/Contents/Info.plist
/usr/local/libexec/vhid-record.app/Contents/MacOS/vhid-record
/usr/local/libexec/vhid-record.app/Contents/_CodeSignature/CodeResources
/usr/local/libexec/vhid-uninstall
/usr/local/libexec/vhid-virtual-hid-driver
/Library/LaunchDaemons/$service.plist
/Library/LaunchAgents/$service.menubar.plist
PATHS
}
if [ "${1:-}" = --paths ]; then paths; exit 0; fi
driver=false
[ "${1:-}" = --driver ] && { driver=true; shift; }
[ $# -eq 0 ] || { echo "usage: sudo $0 [--driver] | $0 --paths" >&2; exit 64; }

say() { echo "vhid-uninstall: $*"; }
fail() { echo "vhid-uninstall: $*" >&2; exit 1; }

if [ "$(id -u)" -eq 0 ]; then
  [ -z "$root" ] || fail "VHID_UNINSTALL_ROOT is for the test, which does not run as root; unset it"
else
  [ -n "$root" ] || fail "removing a root daemon takes root: sudo $0"
fi

# @STOP_JOB@

removed=0
pqrs_scripts="/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice/scripts/uninstall"

# The driver, when asked for, by the removal scripts/virtual-hid-driver makes, read through
# vhid: both the copies packed with this script, found from where it runs. As installed
# that is /usr/local; the Homebrew cask keeps a copy of all three in the same layout, which
# outlives the files this run deletes, so `brew uninstall --zap` can run --driver after
# brew's uninstall has already removed vhid. [LAW:one-source-of-truth]
# It runs as a bash of its own: its steps count on stopping at the first failure, which a
# function called on the left of || here would not do. Its refusals - Karabiner-Elements
# installed, a registration it cannot read, nobody logged in to withdraw it - are asked
# before any job is stopped, so a refused --driver leaves vhid running as it found it; the
# removal itself goes after vhid's jobs let go of the driver and before the files it needs.
tools=$(cd "$(dirname "$0")/.." && pwd)
driver_script=$tools/libexec/vhid-virtual-hid-driver
driver_step() {
  VHID_DRIVER_ROOT=$root REMOVE_AGAIN="sudo $0 --driver" \
    CONFIRM_ABSENT="systemextensionsctl list, which should list no org.pqrs extension" \
    /bin/bash -c 'source "$1"; VHID=$2; "$3"' _ "$driver_script" "$tools/bin/vhid" "$1"
}
if $driver; then
  if [ ! -f "$driver_script" ]; then
    say "the driver removal packed with this script is not at $driver_script; if the pqrs driver is here, its own scripts remove it: $pqrs_scripts"
  else
    # The development daemon a build of this tree runs uses this same driver.
    if record=$(launchctl print "system/$service.dev" 2>&1); then
      fail "the development job $service.dev is loaded and uses the driver; stop it (scripts/dev-daemon remove) before removing the driver, or run without --driver"
    elif ! grep -q "Could not find service" <<<"$record"; then
      fail "could not read whether the development job $service.dev, which would use the driver, is loaded, so nothing was stopped or removed: $record"
    fi
    driver_step remove_refusals || fail "nothing was stopped or removed"
  fi
fi

# The daemon first: its record is the one whose reading decides whether anything is
# removed. Only launchd's "no such job" means nothing is loaded; a record it could not
# read is not taken for an absent one, and nothing is removed from under a job that may
# still run. [LAW:no-silent-failure]
if record=$(launchctl print "system/$service" 2>&1); then
  why=$(stop_job "system/$service") || fail "$why; nothing was removed"
  say "stopped system/$service"
  removed=$((removed + 1))
elif ! grep -q "Could not find service" <<<"$record"; then
  fail "could not read whether $service is loaded, so nothing was removed: $record"
fi

# The menu bar item in every session someone is logged into - each has a loginwindow
# of its own. It is a view of vhid, so one that will not stop, or whose record cannot
# be read, is said and does not keep the rest from being removed: with its plist gone,
# launchd does not start it again at that person's next login.
# The login screen's own loginwindow runs as root, and Setup Assistant's user is a
# system one too; neither is a person's session, so only uids from 500 up count.
for uid in $(ps -axo uid=,comm= | awk '$2 ~ /(^|\/)loginwindow$/ && $1 >= 500 { print $1 }' | sort -u); do
  agent="gui/$uid/$service.menubar"
  if record=$(launchctl print "$agent" 2>&1); then
    if why=$(stop_job "$agent"); then
      say "stopped $agent"
      removed=$((removed + 1))
    else
      say "could not stop the menu bar item in $agent ($why); it goes when that session logs out"
    fi
  elif ! grep -q "Could not find service" <<<"$record"; then
    say "could not read whether the menu bar item runs in $agent: $record"
  fi
done

if $driver && [ -f "$driver_script" ]; then
  # Where the removal left the driver is read afresh rather than taken from its exit
  # status: 2 is how it reports a restart pending, but a failed step under its errexit can
  # end it with 2 as well.
  # A driver already gone is nothing removed, so a second run can say so.
  if [ "$(driver_step report_state 2>/dev/null)" = absent ]; then status=0 verdict=already-absent; else
    status=0
    driver_step cmd_remove || status=$?
    verdict=$(driver_step report_state 2>/dev/null) || verdict=unknown
  fi
  case "$status $verdict" in
    "0 already-absent") ;;
    "0 absent" | "0 pending-reboot" | "2 pending-reboot") removed=$((removed + 1)) ;;
    *) fail "the driver's removal did not finish (above says why; it now reads '$verdict'). vhid's jobs are stopped and this run removed none of its files: run sudo $0 --driver again once that is fixed, or sudo $0 to remove vhid alone" ;;
  esac
fi

while IFS= read -r path; do
  if [ -e "$root$path" ] || [ -L "$root$path" ]; then
    rm -f "$root$path"
    say "removed $path"
    removed=$((removed + 1))
  fi
done <<<"$(paths)"

# The directories only the tap app's bundle has, deepest first, once the files above have
# left them empty, unannounced: its files were. rmdir leaves any that something else put a
# file in.
for directory in Contents/_CodeSignature Contents/MacOS Contents ""; do
  directory=$root/usr/local/libexec/vhid-record.app${directory:+/$directory}
  [ -d "$directory" ] && rmdir "$directory" 2>/dev/null || :
done

if pkgutil --pkg-info "$receipt" >/dev/null 2>&1; then
  pkgutil --forget "$receipt" >/dev/null || fail "pkgutil would not forget the $receipt receipt"
  say "forgot the $receipt receipt"
  removed=$((removed + 1))
fi

if [ $removed -eq 0 ]; then
  say "nothing to remove: no vhid job, file or receipt is here"
else
  if $driver; then
    say "done"
  else
    say "done. The pqrs driver the pkg installed stays, since Karabiner-Elements may use it too; its own scripts remove it: $pqrs_scripts"
  fi
fi
