#!/bin/bash
# Runs as root before the payload lands. Stops the job a previous install of this pkg
# left loaded, so postinstall's bootstrap loads the new plist rather than being refused
# on a label that is still held: launchd adds no second job under one label, and says so
# as exit 5, "Bootstrap failed: Input/output error".
#
# The service name is the file beside this script, written by scripts/make-pkg from the
# answer the packed vhid gives, so the job stopped here is the one postinstall starts.
# [LAW:one-source-of-truth]
set -euo pipefail

service=$(cat "$(dirname "$0")/service")

fail() { echo "vhid preinstall: $*" >&2; exit 1; }

# shellcheck source=stop-job
source "$(dirname "$0")/stop-job"
stop() { local why; why=$(stop_job "$1") || fail "$why"; }

# Only launchd's own "no such job" means nothing is loaded. Anything else read nothing,
# and a failed install is better than one that carries on as if the label were free.
# [LAW:no-silent-failure]
if record=$(launchctl print "system/$service" 2>&1); then
  echo "vhid preinstall: stopping the loaded $service job"
  stop "system/$service"
elif grep -q "Could not find service" <<<"$record"; then
  echo "vhid preinstall: no $service job is loaded"
else
  fail "could not read whether $service is loaded: $record"
fi

# The menu bar item a previous install started in the logged-in person's session, stopped
# for the same reason: postinstall starts the new one under the same label. A session
# with nobody in it has no item to stop. Launched at login in every other session, which
# picks up the new binary at its next login.
agent="$service.menubar"
console=$(stat -f %Su /dev/console)
case "$console" in
  root|loginwindow|_mbsetupuser) ;;
  *)
    domain="gui/$(id -u "$console")"
    if launchctl print "$domain/$agent" >/dev/null 2>&1; then
      # A view of vhid, so a failure to stop it is said and not failed on, in a subshell
      # because `stop` exits on failure.
      ( stop "$domain/$agent" ) \
        && echo "vhid preinstall: stopped the menu bar item for $console" \
        || echo "vhid preinstall: could not stop the menu bar item for $console; it is replaced at the next login"
    fi ;;
esac
