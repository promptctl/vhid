#!/bin/bash
# Claude Code's SessionStart hook for the vhid plugin. Says, before the agent reaches for
# a tool, why vhid cannot answer on this Mac, or answer as the plugin's skills describe,
# and the step that fixes it, so the first the agent hears of a missing install, a binary
# of another version or a grant look needs is not a server that failed to start or a
# click that was refused. Prints nothing when vhid is installed at the plugin's version,
# `vhid doctor` says `ready` and every grant is held; whatever it prints, Claude Code adds
# to the session's context.
#
# The binary is the one the plugin's .mcp.json runs, read from it rather than named again
# here, so the check and the server cannot come to look in different places.
# [LAW:one-source-of-truth]
#
# hooks.json gives it 90 seconds: `vhid doctor` reads in series, and its slowest probes,
# the driver's and launchd's, have Command.limit (30 s) each and the daemon's status call
# HelperConnection.replyTimeout (5 s), asked twice after a refusal. A hook stopped short of
# that says nothing at all, in the one state where there is most to say.
#
# Held to bash 3.2, like every script here.
set -uo pipefail

root=${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
servers=$root/.mcp.json

vhid=$(plutil -extract "mcpServers.vhid.command" raw -o - "$servers" 2>&1) \
  || { echo "vhid plugin: $servers names no command for the vhid server: $vhid" >&2; exit 1; }
# [LAW:one-source-of-truth] The version the plugin was written for is the one its release's
# binaries were built as: scripts/version reads this same file for every build, and refuses
# to build from one that is not a version, so the release that shipped it has checked it.
written_for=$(tr -d '[:space:]' <"$root/VERSION") && [ -n "$written_for" ] \
  || { echo "vhid plugin: $root/VERSION does not say the version the plugin was written for" >&2; exit 1; }

if [ ! -x "$vhid" ]; then
  cat <<EOF
vhid is not installed on this Mac: there is no $vhid, so what this plugin's MCP server runs is missing and this session cannot look at the screen, type or click. If the user asks for that, tell them so and give them the steps: \`brew install --cask promptctl/tap/vhid\` (or the pkg from https://github.com/promptctl/vhid/releases/latest), then turn on the driver extension as https://github.com/promptctl/vhid/blob/master/docs/guide.md#installing describes, then start a new Claude Code session.
EOF
  exit 0
fi

# The installed binary, when it is not the plugin's version, with what it said. The
# versions are said, not ordered: which is newer is for the agent to read off them, so the
# hook keeps no second rule for it beside scripts/newest-release. The version is stdout
# alone, so a diagnostic on stderr cannot make a match a mismatch; a --version that failed
# is asked again for everything it printed, to say it, and so is one that printed no version.
reported=$("$vhid" --version 2>/dev/null)
status=$?
case "$status:$reported" in
  "0:$written_for") differ= ;;
  0:?*) differ="$vhid is $reported" ;;
  *) differ="$vhid --version failed with exit status $status and printed: $("$vhid" --version 2>&1)" ;;
esac
[ -z "$differ" ] || cat <<EOF
This vhid plugin was written for vhid $written_for, and the installed binary is not that version: $differ. The plugin's skills describe the tools of $written_for, so a tool may refuse arguments a skill gives it. If the binary is older than $written_for, the step is \`brew upgrade --cask vhid\` (or the pkg from https://github.com/promptctl/vhid/releases/latest), then a new Claude Code session. If it is newer, the step is \`claude plugin marketplace update vhid\` and \`claude plugin update vhid@vhid\`, then a new session. A version with a tag after its number, such as -rc.1 or -dev+<commit>, is a pre-release or a development build, which no plugin release is written for, so updating the plugin does not clear this, and its tools may take other arguments than the skills describe; \`brew reinstall --cask vhid\` (or the pkg from https://github.com/promptctl/vhid/releases/latest) puts the release back. If a tool refuses what a skill told you to pass, tell the user this and the step.

EOF

doctor=$("$vhid" doctor 2>&1)
status=$?
# Exit 1 is the doctor's "not ready" only when its verdict says so: ArgumentParser also
# exits 1 for an error the doctor threw, which prints that error and no rows.
case "$status:$doctor" in
  0:*) verdict= ;;
  "1:not ready"*) verdict="vhid is installed but not ready, so the vhid tools will refuse to type or click until the row below that is not met is put right." ;;
  *) verdict="vhid is installed, but \`vhid doctor\` failed with exit status $status, so whether its tools can type or click is unknown." ;;
esac
# Whether look can read the screen, from the exit status `read-grants` answers it with -
# 0 every grant held, 3 one not (GrantReading.exitStatus) - never from what it prints: the
# reading is vhid's to judge, and the hook keeps no second reader of its line; GrantsTests
# holds these arms to the statuses a reading exits with. Any other
# status is a reading that failed, said as unknown. [LAW:one-source-of-truth] [LAW:no-silent-failure]
grants=$("$vhid" read-grants 2>&1)
status=$?
case $status in
  0) sight= ;;
  3) sight="A grant look reads the screen by is not held, so look reads less than is on screen until the app \`vhid doctor\` names below holds it." ;;
  *) sight="Whether look can read the screen is unknown: \`vhid read-grants\` exited $status and printed: $grants" ;;
esac
[ -z "$verdict" ] && [ -z "$sight" ] && exit 0
cat <<EOF
${verdict:+$verdict }${sight:+$sight }\`vhid doctor\` says:

$doctor

If the user asks for input on screen, or for a look at it, tell them this and the step the row names. A driver extension and a grant can be turned on only by the person at the Mac. look does not need the devices to be ready, only its grants.
EOF
