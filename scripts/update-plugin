#!/bin/bash
# Moves the branch the Claude Code marketplace installs the plugin from to a release, in a
# checkout of vhid holding that release's tag: commits the release's claude-plugin/ onto
# the branch as origin has it, and pushes. The commit's tree is claude-plugin/ as of the
# tag and nothing else, its parent is the branch as it was, and its Release trailer is the
# version. release.yaml runs it once a release is published, and a person runs it, from a
# checkout of master, when that step failed (docs/releasing.md).
#
#   scripts/update-plugin <checkout> <version>
#
# The branch holds no .github/workflows, so pushing it never changes a workflow file:
# GitHub refuses that from the release job's token, which cannot be given the workflows
# permission.
#
# Held to bash 3.2, like every script here.
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: scripts/update-plugin <checkout> <version>" >&2; exit 2; }
checkout=$1 version=$2
newest=$(dirname "$0")/newest-release
marketplace=$checkout/.claude-plugin/marketplace.json

# [LAW:parse-dont-validate] The plugin goes to everyone who installs it, so it takes a
# release, never a pre-release, as the cask does.
"$newest" "$version" >/dev/null || {
  echo "update-plugin: '$version' is not a release version, as scripts/newest-release decides" >&2
  exit 2
}
# [LAW:one-source-of-truth] The branch is the ref marketplace.json gives the vhid plugin,
# the one place it is named.
branch=
plugins=$(plutil -extract plugins raw -o - "$marketplace")
for ((i = 0; i < plugins; i++)); do
  [ "$(plutil -extract "plugins.$i.name" raw -o - "$marketplace")" = vhid ] || continue
  branch=$(plutil -extract "plugins.$i.source.ref" raw -o - "$marketplace")
  break
done
[ -n "$branch" ] || { echo "update-plugin: $marketplace has no plugin named vhid" >&2; exit 1; }
plugin=$(git -C "$checkout" rev-parse --verify --quiet "refs/tags/v$version^{commit}:claude-plugin") \
  || { echo "update-plugin: $checkout has no tag v$version holding claude-plugin/" >&2; exit 1; }
tree=$(printf '040000 tree %s\tclaude-plugin\n' "$plugin" | git -C "$checkout" mktree)

# Release jobs of two tags run side by side, so a push can lose to the other's: the
# branch is fetched again and the move decided again from where the other left it.
for attempt in 1 2 3; do
  git -C "$checkout" fetch --quiet origin "+refs/heads/$branch:refs/heads/$branch"
  tip=$(git -C "$checkout" rev-parse "refs/heads/$branch^{commit}")
  # The branch's tip names the release it holds, once, and nothing else records it.
  was=$(git -C "$checkout" log -1 --format='%(trailers:key=Release,valueonly)' "$tip" | sed '/^$/d')
  case $was in *$'\n'*) was= ;; esac
  "$newest" "$was" >/dev/null \
    || { echo "update-plugin: $branch's tip $tip names no one release by its Release trailer" >&2; exit 1; }
  # Only forward: a newer release's job that finished first, or an older release's job
  # run again, leaves the plugin where it is.
  if [ "$("$newest" "$was" "$version")" = "$was" ]; then
    echo "update-plugin: $branch holds vhid $was, at $version or past it"
    exit 0
  fi
  commit=$(git -C "$checkout" commit-tree "$tree" -p "$tip" \
    -m "vhid $version: claude-plugin/ as of v$version" -m "Release: $version")
  if git -C "$checkout" push --quiet origin "$commit:refs/heads/$branch"; then
    git -C "$checkout" update-ref "refs/heads/$branch" "$commit" "$tip"
    echo "update-plugin: $branch vhid $was -> $version, commit $commit, push $attempt"
    exit 0
  fi
done
echo "update-plugin: $branch was not moved to vhid $version after $attempt pushes" >&2
exit 1
