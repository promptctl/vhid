#!/bin/bash
# scripts/newest-release, which update-cask, cask.yaml and release.yaml all read: releases
# alone, in sort -V's order, and exit 1 with nothing printed when none is one.
#
# Held to bash 3.2, like every script here.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

failed=0
fail() { echo "newest-release-test: $1" >&2; failed=1; }

newest() {
  local want=$1; shift
  local got status
  got=$(scripts/newest-release "$@"); status=$?
  [ "$status" -eq 0 ] || fail "newest-release $* exited $status"
  [ "$got" = "$want" ] || fail "newest-release $* printed '$got', not '$want'"
}
none() {
  local got status
  got=$(scripts/newest-release "$@"); status=$?
  [ "$status" -eq 1 ] || fail "newest-release $* exited $status, not 1"
  [ -z "$got" ] || fail "newest-release $* printed '$got', not nothing"
}
newest 0.10.0 0.9 0.10.0 0.4.0
newest 0.4.0 0.5.0-rc.1 0.4.0
newest 0.4.0 0.4.0
none 0.2.0-rc.1
none 0.2/0 ""
none ""
none

[ "$failed" -eq 0 ] && echo "newest-release-test: ok"
exit "$failed"
