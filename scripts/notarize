#!/bin/bash
# Notarizes a signed pkg, staples the ticket to it, and asks Gatekeeper about it the way
# a Mac that downloaded it would.
#
#   NOTARY_PROFILE=<profile> scripts/notarize <pkg>
#
# The profile is a notarytool credential in the login keychain - or in NOTARY_KEYCHAIN,
# where scripts/release-keychain puts it for the release workflow - made once per Mac with
# `xcrun notarytool store-credentials <profile>`, from an Apple ID and an app-specific
# password or from an App Store Connect API key.
#
# Held to bash 3.2, like every script here.
set -euo pipefail

# shellcheck source=notary-keychain
source "$(dirname "${BASH_SOURCE[0]}")/notary-keychain"

pkg=${1:?usage: NOTARY_PROFILE=<profile> scripts/notarize <pkg>}
profile=${NOTARY_PROFILE:?NOTARY_PROFILE names the notarytool keychain profile; make one with xcrun notarytool store-credentials}

fail() { echo "notarize: $*" >&2; exit 1; }

[ -f "$pkg" ] || fail "there is no pkg at $pkg"

# notarytool's exit status alone does not separate a refused submission from one that
# never reached the service, and only the first has a log to fetch; the status the
# service answered with decides. [LAW:no-silent-failure]
result=$(xcrun notarytool submit "$pkg" --keychain-profile "$profile" ${notary_keychain[@]+"${notary_keychain[@]}"} --wait --output-format plist) \
  && submitted=0 || submitted=$?
status=$(plutil -extract status raw -o - - <<<"$result") || status=none
if [ "$status" != Accepted ]; then
  echo "notarize: notarytool exited $submitted with status '$status': $result" >&2
  id=$(plutil -extract id raw -o - - <<<"$result") \
    && xcrun notarytool log "$id" --keychain-profile "$profile" ${notary_keychain[@]+"${notary_keychain[@]}"} >&2
  exit 1
fi

xcrun stapler staple "$pkg" >&2
xcrun stapler validate "$pkg" >&2

"$(dirname "$0")/assess-pkg" "$pkg"
echo "$pkg"
