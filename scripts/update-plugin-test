#!/bin/bash
# scripts/update-plugin run against a scratch checkout whose origin is a scratch bare
# repository, with releases' tags and a plugin branch at the first, so nothing here
# reaches promptctl/vhid.
#
# [LAW:behavior-not-structure] What is checked is origin's branch after each run - its
# tree, its parent and the release it names - and what the script said and exited with.
#
# Held to bash 3.2, like every script here.
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

SCRATCH=$(mktemp -d) || exit 1
trap 'rm -rf "$SCRATCH"' EXIT
failed=0
fail() { echo "update-plugin-test: $1" >&2; failed=1; }

ORIGIN=$SCRATCH/origin.git
REPO=$SCRATCH/vhid
BRANCH=latest-release
git init --quiet --bare "$ORIGIN"
git init --quiet "$REPO"
git -C "$REPO" config user.name test
git -C "$REPO" config user.email test@example.com
git -C "$REPO" remote add origin "$ORIGIN"
# The vhid entry second, behind one whose source is a path, so it is found by name.
mkdir -p "$REPO/.claude-plugin"
cat >"$REPO/.claude-plugin/marketplace.json" <<J
{"name": "vhid", "plugins": [
  {"name": "other", "source": "./other"},
  {"name": "vhid", "source": {"source": "git-subdir", "url": "$ORIGIN", "path": "claude-plugin", "ref": "$BRANCH"}}
]}
J
# A release: claude-plugin/ and a workflow beside it, tagged v<version>.
release() {
  mkdir -p "$REPO/claude-plugin" "$REPO/.github/workflows"
  echo "skill of $1" >"$REPO/claude-plugin/SKILL.md"
  echo "workflow of $1" >"$REPO/.github/workflows/release.yaml"
  git -C "$REPO" add -A
  git -C "$REPO" commit --quiet -m "$1"
  git -C "$REPO" tag -a "v$1" -m "$1"
}
# Puts a commit of <tree> naming <trailer> on origin's branch, as another hand would.
put() {
  git -C "$REPO" push --quiet --force origin \
    "$(git -C "$REPO" commit-tree "$1" -p "$(origin_tip)" -m elsewhere -m "$2"):refs/heads/$BRANCH"
}
origin_tip() { git -C "$ORIGIN" rev-parse "$BRANCH"; }
release 0.1.0
# The branch as the marketplace first named it: a whole release commit, naming 0.1.0.
git -C "$REPO" push --quiet origin \
  "$(git -C "$REPO" commit-tree "v0.1.0^{tree}" -p "v0.1.0^{commit}" -m start -m "Release: 0.1.0"):refs/heads/$BRANCH"
release 0.2.0
release 0.3.0
git -C "$REPO" tag -a v0.4.0-rc1 -m rc

run() { out=$(scripts/update-plugin "$REPO" "$@" 2>&1); status=$?; }
# A run that should be refused, or find the branch at or past it, leaves origin's branch
# as it was.
unmoved() {
  local want_status=$1 want=$2; shift 2
  local before; before=$(origin_tip)
  run "$@"
  [ "$status" -eq "$want_status" ] || fail "update-plugin $* exited $status, not $want_status: $out"
  case $out in *"$want"*) ;; *) fail "update-plugin $* said \"$out\", not \"$want\"" ;; esac
  [ "$(origin_tip)" = "$before" ] || fail "update-plugin $* moved $BRANCH"
}
# The run moved origin's branch from <before> to <version>'s plugin alone.
moved() {
  local before=$1 version=$2
  [ "$status" -eq 0 ] || fail "update-plugin $version exited $status: $out"
  [ "$(git -C "$ORIGIN" rev-parse "$BRANCH^")" = "$before" ] || fail "$version's tip's parent is not the branch as it was"
  [ "$(git -C "$ORIGIN" ls-tree --name-only "$BRANCH")" = claude-plugin ] \
    || fail "$version's tip holds $(git -C "$ORIGIN" ls-tree --name-only "$BRANCH" | tr '\n' ' '), not claude-plugin alone"
  [ "$(git -C "$ORIGIN" rev-parse "$BRANCH:claude-plugin")" = "$(git -C "$REPO" rev-parse "v$version:claude-plugin")" ] \
    || fail "$version's tip's claude-plugin/ is not v$version's"
  [ "$(git -C "$ORIGIN" log -1 --format='%(trailers:key=Release,valueonly)' "$BRANCH" | sed '/^$/d')" = "$version" ] \
    || fail "$version's tip does not name release $version"
}

before=$(origin_tip)
run 0.2.0
moved "$before" 0.2.0
case $out in *"vhid 0.1.0 -> 0.2.0"*"push 1"*) ;; *) fail "update-plugin 0.2.0 said \"$out\"" ;; esac
unmoved 0 "holds vhid 0.2.0, at 0.2.0 or past it" 0.2.0
unmoved 0 "holds vhid 0.2.0, at 0.1.0 or past it" 0.1.0
unmoved 2 "'0.4.0-rc1' is not a release version" 0.4.0-rc1
unmoved 1 "no tag v0.5.0" 0.5.0

# A push that loses to another job's is tried again from where that job left the branch.
cat >"$ORIGIN/hooks/update" <<H
#!/bin/sh
[ -f "$SCRATCH/lose" ] || exit 0
rm "$SCRATCH/lose"
exit 1
H
chmod +x "$ORIGIN/hooks/update"
touch "$SCRATCH/lose"
before=$(origin_tip)
run 0.3.0
moved "$before" 0.3.0
case $out in *"vhid 0.2.0 -> 0.3.0"*"push 2"*) ;; *) fail "update-plugin 0.3.0 after a lost push said \"$out\"" ;; esac
rm "$ORIGIN/hooks/update"

# A newer release's job that got there first leaves this checkout's copy behind origin;
# the move is decided from origin's.
put "$(git -C "$REPO" rev-parse "$BRANCH^{tree}")" "Release: 9.0.0"
unmoved 0 "holds vhid 9.0.0, at 0.3.0 or past it" 0.3.0

put "$(git -C "$REPO" rev-parse "$BRANCH^{tree}")" "$(printf 'Release: 9.1.0\nRelease: 0.1.0')"
unmoved 1 "names no one release" 0.3.0
put "$(git -C "$REPO" rev-parse "$BRANCH^{tree}")" "no trailer"
unmoved 1 "names no one release" 0.3.0

printf '{"plugins": [{"name": "other", "source": "./other"}]}\n' >"$REPO/.claude-plugin/marketplace.json"
unmoved 1 "has no plugin named vhid" 0.3.0

exit $failed
