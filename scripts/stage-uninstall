#!/bin/bash
# Writes pkg/uninstall to stdout with the service it stops written in: the one step
# between the source and what the pkg ships, taken by scripts/make-pkg and by
# scripts/uninstall-test alike, so the test runs what ships.
#
#   scripts/stage-uninstall <service> <receipt identifier>
#
# Held to bash 3.2, like every script here.
set -euo pipefail
service=${1:?usage: scripts/stage-uninstall <service> <receipt identifier>}
receipt=${2:?usage: scripts/stage-uninstall <service> <receipt identifier>}
cd "$(dirname "${BASH_SOURCE[0]}")/.."
# A launchd label and a package identifier, which are written into the script unquoted:
# nothing that could be read as shell.
for value in "$service" "$receipt"; do
  [[ $value =~ ^[A-Za-z0-9._-]+$ ]] || { echo "stage-uninstall: '$value' is not a label" >&2; exit 1; }
done
for marker in '^service=@SERVICE@$' '^receipt=@RECEIPT@$' '^# @STOP_JOB@$'; do
  [ "$(grep -c "$marker" pkg/uninstall)" = 1 ] \
    || { echo "stage-uninstall: pkg/uninstall has no single line matching $marker to fill" >&2; exit 1; }
done
# stop-job goes in without its shebang, where the marker was.
awk -v service="$service" -v receipt="$receipt" '
  $0 == "service=@SERVICE@" { print "service=" service; next }
  $0 == "receipt=@RECEIPT@" { print "receipt=" receipt; next }
  $0 == "# @STOP_JOB@" { while ((getline line < "pkg/scripts/stop-job") > 0) if (line !~ /^#!/) print line; next }
  { print }' pkg/uninstall
