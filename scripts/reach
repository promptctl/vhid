#!/bin/bash
# Walks one row of the matrix in docs/design/remote-hands.md on a real Mac: calls the
# installed vhid over SSH, as the matrix was measured, and checks each column against the
# cell the table states. CI cannot reach a login window, so a person arranges the place
# first; the setup line of each place below says what to put on screen.
#
#   scripts/reach <host> <place>      prints one line per column; exits 1 if any differs
#   scripts/reach <host>              lists the places and what to arrange for each
#
# SSH as the user the matrix says. A keystroke is shown landed by its effect: a file the
# typed shell command made, or the system logging the wrong password vhid typed. FileVault
# pre-boot is not a place here: nothing of vhid is running to probe.
#
# Held to bash 3.2, like every script here.
set -uo pipefail

# The cells docs/design/remote-hands.md measured, which stays their source; restated here
# one row per place, in its order: name | how a keystroke shows it landed | what to arrange.
places='console|shell|Terminal frontmost, logged in as the SSH user
secure-input|shell|as console, with Terminal > Secure Keyboard Entry on
password-prompt|auth|a system password prompt focused, raised in the user'"'"'s GUI session, since one started over plain SSH has no UI: sudo launchctl asuser <uid> sudo -u <user> osascript -e '"'"'do shell script "true" with administrator privileges'"'"'
lock-screen|auth|the SSH user'"'"'s lock screen, its password field focused (Control-Command-Q)
login-window|auth|the login window with nobody logged in, a user'"'"'s password field focused
fast-user-switch|auth|the login window after fast user switching, the SSH user in the background, a password field focused'

[ $# -ge 1 ] || { echo "usage: scripts/reach <host> [place]" >&2; exit 2; }
host=$1
if [ $# -lt 2 ]; then
  echo "$places" | awk -F'|' '{ printf "%-17s %s\n", $1, $3 }'
  exit 0
fi
row=$(echo "$places" | awk -F'|' -v p="$2" '$1 == p')
[ -n "$row" ] || { echo "reach: no place '$2'; scripts/reach $host lists them" >&2; exit 2; }
IFS='|' read -r place evidence setup <<EOF
$row
EOF

# Every call runs on the target, where vhid is installed and not on a non-login PATH.
# One connection shared by every call, closed a minute after the last.
on() { ssh -o ConnectTimeout=10 -o ControlMaster=auto -o "ControlPath=/tmp/reach-%C" -o ControlPersist=60 "$host" "PATH=/usr/local/bin:\$PATH; $1"; }

failed=0
cell() { # column, expected, observed, matched
  printf '%-10s %-5s expected %-28s observed %s\n' "$1" "$([ "$4" = 0 ] && echo ok || echo DIFF)" "$2" "$3"
  [ "$4" = 0 ] || failed=1
}

echo "place      $place: $setup"
echo "target     $(on 'sw_vers -productVersion; vhid --version' | paste -sd ' ' -) (macOS, vhid)"
front=$(on 'lsappinfo info -only name "$(lsappinfo front)"' | sed 's/.*="//; s/"$//')
echo "front      $front"
# The sessions macOS keeps, from IOConsoleUsers: who holds the console, how many sessions
# the SSH user has, and whether the session in front is locked or has secure input on.
me=$(on 'id -un')
console=$(on 'stat -f %Su /dev/console')
sessions=$(on 'ioreg -n Root -d1 -a | plutil -extract IOConsoleUsers xml1 -o - -')
field() { echo "$sessions" | plutil -extract "$1" raw -o - - 2>/dev/null; }
mine=0 locked=false holder=none i=0
# Walks the array until plutil finds no index i; that miss is the loop's end, not an error.
while name=$(field $i.kCGSSessionUserNameKey); do
  [ "$name" = "$me" ] && mine=$((mine + 1))
  if [ "$(field $i.kCGSSessionOnConsoleKey)" = true ]; then
    # macOS sets these keys only while true: a missing one is an unlocked session, or
    # nobody holding secure input.
    [ "$(field $i.CGSSessionScreenIsLocked)" = true ] && locked=true
    pid=$(field $i.kCGSSessionSecureInputPID) && holder=$(basename "$(on "ps -p $pid -o comm=")")
  fi
  i=$((i + 1))
done
echo "sessions   console $console; $me has $mine session(s); in front: locked $locked, secure input held by $holder"

# The place is arranged before anything is typed or clicked: on the wrong screen the
# keystrokes would go to whatever is there, and no cell below could speak for the place.
# The login window holds the console as root.
case $place in
  console) wanted="$me in Terminal, unlocked"; [ "$console" = "$me" ] && [ "$front" = Terminal ] && [ $locked = false ] ;;
  secure-input) wanted="$me in Terminal, its secure input"; [ "$console" = "$me" ] && [ "$front" = Terminal ] && [ "$holder" = Terminal ] ;;
  password-prompt) wanted="$me, SecurityAgent in front"; [ "$console" = "$me" ] && [ "$front" = SecurityAgent ] ;;
  lock-screen) wanted="$me in front, locked"; [ "$console" = "$me" ] && [ $locked = true ] ;;
  login-window) wanted="root, no session of $me"; [ "$console" = root ] && [ $mine = 0 ] ;;
  fast-user-switch) wanted="root, $me in the background"; [ "$console" = root ] && [ $mine -gt 0 ] ;;
esac
rc=$?

cell arranged "$wanted" "$console in $front, locked $locked, secure $holder, $mine of $me" $rc
[ $rc = 0 ] || exit 1

doctor=$(on 'vhid doctor' 2>&1)
[ "$(echo "$doctor" | head -n 1)" = ready ]; rc=$?
cell xpc 'doctor: ready' "$(echo "$doctor" | head -n 1)" $rc

# The two ways a keystroke shows itself, the same four calls either way: type, return,
# then read back the effect.
nonce=vhid-reach-$$-$RANDOM
case $evidence in
  shell)
    text="touch /tmp/$nonce"
    effect="test -e /tmp/$nonce && rm /tmp/$nonce && echo 'the typed command ran'"
    ;;
  auth)
    text=$nonce
    since=$(on "date '+%Y-%m-%d %H:%M:%S'")
    # /usr/bin/log by path: in zsh, the login shell ssh runs this in, `log` is a builtin.
    effect="/usr/bin/log show --style compact --start '$since' --predicate 'eventMessage CONTAINS \"ODErrorCredentialsInvalid\" OR eventMessage CONTAINS \"Failed to authenticate user\"' | grep -m 1 -o -e ODErrorCredentialsInvalid -e 'Failed to authenticate user'"
    ;;
esac
typed=$(on "vhid type '$text' && vhid press return" 2>&1)
layout=$(echo "$typed" | grep -o 'on [^ ]*$' | head -n 1)
cell layout 'a layout named' "${layout:-none: $typed}" "$([ -n "$layout" ]; echo $?)"
sleep 2
# Any credential failure logged since counts: the log never names the password typed.
landed=$(on "$effect" 2>&1); rc=$?
landed=$(echo "$landed" | head -n 1)
cell keystroke "$evidence evidence" "${landed:-nothing}" $rc

# The click lands where it was sent, in every place: the daemon reads the cursor in the
# session in front, whoever's it is.
x=40 y=400
clicked=$(on "vhid click $x $y" 2>&1); clicked_rc=$?
cursor=$(on 'vhid cursor' 2>&1)
# The pointer settles within two points of its target, not on it.
echo "$cursor" | tr -d '(),' | awk -v x=$x -v y=$y '{ dx = $5 - x; dy = $6 - y; exit !(dx * dx <= 4 && dy * dy <= 4) }'; rc=$?
cell cursor "($x, $y) after the click" "$cursor" $rc
cell click 'placed, exit 0' "exit $clicked_rc" $clicked_rc
exit $failed
